{
  "name": "cmc",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:local:migrate": "DATABASE_URL='postgresql://prisma:prisma@localhost:5432/prisma?schema=public' yarn prisma migrate deploy",
    "db:local:up": "docker compose up -d postgres",
    "deps:audit": "node scripts/dependency-audit.js",
    "deploy:check": "node scripts/deployment-readiness.js",
    "deploy:aliases": "node scripts/deployment-alias-policy-check.js",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "security:audit-cleanup:rehearse": "node scripts/audit-cleanup-rehearsal.mjs",
    "security:access-reviews": "node scripts/admin-access-review-metrics.mjs",
    "security:alerts": "node scripts/security-alert-check.mjs",
    "env:matrix": "node scripts/environment-matrix-check.js",
    "security:rls": "node scripts/rls-grant-check.mjs",
    "seed:e2e": "node scripts/seed-e2e-data.mjs",
    "smoke:health": "node scripts/health-smoke-test.js",
    "routes:check": "node scripts/route-manifest-check.js",
    "sanity": "node scripts/sanity-check.js",
    "smoke": "node scripts/smoke-test.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:visual": "playwright test test/e2e/visual-qa.spec.js",
    "test:integration": "node --test test/integration/**/*.test.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "lint": "eslint ."
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@popperjs/core": "^2.11.4",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "aws-sdk": "^2.1141.0",
    "bootstrap": "^5.1.3",
    "formik": "^2.2.9",
    "next": "16.2.9",
    "next-auth": "4.24.14",
    "nodemailer": "^8.0.11",
    "pg": "^8.16.3",
    "react": "19.2.7",
    "react-bootstrap": "^2.4.0",
    "react-dom": "19.2.7",
    "react-use-cart": "^1.13.0",
    "stripe": "22.2.0",
    "uuid": "^8.3.2",
    "wavesurfer.js": "^6.2.0",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "prisma": "7.8.0",
    "typescript": "6.0.3"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  }
}
