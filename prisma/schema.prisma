// The models Account, Session, Verification and some of User were provided by
// Next Auth @ https://next-auth.js.org/adapters/prisma
// These are standardised models that are used by Next Auth across all platforms.  

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  // output = "../generated"
  // output = "/node_modules/prisma/prisma-client"
  // binaryTargets = ["native"]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                            String                    @id @default(cuid())
  name                          String?
  email                         String?                   @unique
  image                         String?
  emailVerified                 String?
  role                          UserRole                  @default(CUSTOMER)
  accountStatus                 UserAccountStatus         @default(ACTIVE)
  uploaderStatus                UploaderStatus            @default(NOT_REQUESTED)
  sessionRevokedBefore          DateTime?
  accounts                      Account[]
  sessions                      Session[]
  Track                         Track[]
  TrackOwners                   TrackOwner[]
  Comment                       Comment[]
  orders                        Order[]
  auditEvents                   AuditEvent[]
  TrackRequests                 TrackRequest[]
  TrackRequestResponses         TrackRequestResponse[]
  WishlistItems                 WishlistItem[]
  CatalogueReleases             CatalogueRelease[]
  UploadBatches                 UploadBatch[]
  RequestPricingProposals       RequestPricingProposal[]
  accessChangeRequestsRequested UserAccessChangeRequest[] @relation("UserAccessChangeRequestedBy")
  accessChangeRequestsReviewed  UserAccessChangeRequest[] @relation("UserAccessChangeReviewedBy")
  accessChangeRequestsTargeted  UserAccessChangeRequest[] @relation("UserAccessChangeTarget")

  @@index([role])
  @@index([accountStatus])
  @@index([uploaderStatus])
  @@index([sessionRevokedBefore])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Track {
  id                        Int                     @id @default(autoincrement())
  fileName                  String
  title                     String
  composer                  String
  status                    TrackStatus             @default(PUBLISHED)
  moderationStatus          TrackModerationStatus   @default(APPROVED)
  processingStatus          TrackProcessingStatus   @default(READY)
  uploadedAt                DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  publishedAt               DateTime?
  reviewedAt                DateTime?
  uploadedBy                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                    String
  uploadBatch               UploadBatch?            @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)
  uploadBatchId             Int?
  previewFileName           String?
  previewStart              Int?
  previewEnd                Int?
  durationSeconds           Int?
  sourceContentType         String?
  price                     Float?
  pricePence                Int?
  currency                  String                  @default("gbp")
  formattedPrice            String?
  catalogueType             CatalogueType           @default(SINGLE_TRACK)
  saleFormat                SaleFormat              @default(INDIVIDUAL)
  pricingTier               String?
  pricingReviewStatus       PricingReviewStatus     @default(AUTO_APPROVED)
  pricingJustification      String?                 @db.Text
  downloadName              String?
  downloadCount             Int?
  key                       String?
  instrumentation           String?
  additionalInfo            String?
  moderationNotes           String?                 @db.Text
  processingError           String?                 @db.Text
  TrackOwner                TrackOwner[]
  Comments                  Comment[]
  TrackRequests             TrackRequest[]
  FulfilledTrackRequests    TrackRequest[]          @relation("TrackRequestFulfilment")
  FulfilledRequestResponses TrackRequestResponse[]  @relation("TrackRequestResponseFulfilment")
  WishlistItems             WishlistItem[]
  orderItems                OrderItem[]
  releaseItems              CatalogueReleaseTrack[]

  @@index([status])
  @@index([userId])
  @@index([uploadBatchId])
  @@index([catalogueType])
  @@index([pricingReviewStatus])
  @@index([status, moderationStatus, processingStatus])
  @@index([status, uploadedAt])
  @@index([userId, status])
}

model UploadBatch {
  id                     Int               @id @default(autoincrement())
  uploadedBy             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String
  label                  String?
  defaultComposer        String?
  defaultInstrumentation String?
  defaultPricePence      Int?
  status                 UploadBatchStatus @default(DRAFT)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  submittedAt            DateTime?
  completedAt            DateTime?
  tracks                 Track[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model CatalogueRelease {
  id                   Int                     @id @default(autoincrement())
  title                String
  composer             String?
  status               CatalogueReleaseStatus  @default(PUBLISHED)
  catalogueType        CatalogueType
  saleFormat           SaleFormat              @default(BUNDLE)
  pricePence           Int?
  currency             String                  @default("gbp")
  formattedPrice       String?
  pricingReviewStatus  PricingReviewStatus     @default(AUTO_APPROVED)
  pricingJustification String?                 @db.Text
  uploadedBy           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  tracks               CatalogueReleaseTrack[]
  tags                 CatalogueReleaseTag[]
  orderItems           OrderItem[]
  trackOwners          TrackOwner[]

  @@index([catalogueType])
  @@index([saleFormat])
  @@index([status])
  @@index([userId, createdAt])
  @@index([pricingReviewStatus])
  @@index([status, pricingReviewStatus])
}

model CatalogueTag {
  id        Int                   @id @default(autoincrement())
  slug      String                @unique
  label     String
  sortOrder Int                   @default(0)
  active    Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  releases  CatalogueReleaseTag[]

  @@index([active, sortOrder])
}

model CatalogueReleaseTag {
  release    CatalogueRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  releaseId  Int
  tag        CatalogueTag     @relation(fields: [tagId], references: [id], onDelete: Restrict)
  tagId      Int
  assignedAt DateTime         @default(now())

  @@id([releaseId, tagId])
  @@index([tagId, releaseId])
}

model CatalogueReleaseTrack {
  id          Int              @id @default(autoincrement())
  release     CatalogueRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  releaseId   Int
  track       Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId     Int
  position    Int              @default(0)
  movementNo  String?
  titleInWork String?

  @@unique([releaseId, trackId])
  @@index([releaseId, position])
  @@index([trackId])
}

model TrackOwner {
  id                 Int               @id @default(autoincrement())
  track              Track             @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId            Int
  purchasedBy        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  sourceRelease      CatalogueRelease? @relation(fields: [sourceReleaseId], references: [id], onDelete: SetNull)
  sourceReleaseId    Int?
  sourceReleaseTitle String?
  purchasedAt        DateTime          @default(now())

  @@unique([trackId, userId])
  @@index([userId])
  @@index([userId, purchasedAt])
  @@index([trackId, purchasedAt])
  @@index([sourceReleaseId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId   Int
  postedBy  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  content   String
  createdAt DateTime @default(now())

  @@index([trackId])
  @@index([userId])
}

model TrackRequest {
  id                 Int                      @id @default(autoincrement())
  requestedBy        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  track              Track?                   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId            Int?
  fulfilledByTrack   Track?                   @relation("TrackRequestFulfilment", fields: [fulfilledByTrackId], references: [id], onDelete: SetNull)
  fulfilledByTrackId Int?
  title              String
  composer           String?
  instrumentation    String?
  notes              String?                  @db.Text
  rejectionReason    String?
  rejectionNote      String?                  @db.Text
  status             TrackRequestStatus       @default(OPEN)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  expiresAt          DateTime?
  pricingProposals   RequestPricingProposal[]
  responses          TrackRequestResponse[]

  @@index([userId, createdAt])
  @@index([trackId, createdAt])
  @@index([fulfilledByTrackId])
  @@index([status, createdAt])
  @@index([expiresAt])
}

model TrackRequestResponse {
  id                   Int                        @id @default(autoincrement())
  request              TrackRequest               @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId            Int
  respondedBy          User                       @relation(fields: [respondedById], references: [id], onDelete: Cascade)
  respondedById        String
  fulfilledByTrack     Track?                     @relation("TrackRequestResponseFulfilment", fields: [fulfilledByTrackId], references: [id], onDelete: SetNull)
  fulfilledByTrackId   Int?
  status               TrackRequestResponseStatus @default(ACCEPTED)
  pricePence           Int?
  currency             String                     @default("gbp")
  catalogueType        CatalogueType              @default(SINGLE_TRACK)
  saleFormat           SaleFormat                 @default(INDIVIDUAL)
  pricingReviewStatus  PricingReviewStatus        @default(AUTO_APPROVED)
  pricingJustification String?                    @db.Text
  responseNote         String?                    @db.Text
  rejectionReason      String?
  rejectionNote        String?                    @db.Text
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  completedAt          DateTime?

  @@unique([requestId, respondedById])
  @@index([requestId, status])
  @@index([respondedById, createdAt])
  @@index([fulfilledByTrackId])
  @@index([pricingReviewStatus, createdAt])
}

model RequestPricingProposal {
  id                   Int                          @id @default(autoincrement())
  request              TrackRequest                 @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId            Int
  proposedBy           User                         @relation(fields: [proposedById], references: [id], onDelete: Cascade)
  proposedById         String
  pricePence           Int
  currency             String                       @default("gbp")
  catalogueType        CatalogueType                @default(SINGLE_TRACK)
  saleFormat           SaleFormat                   @default(INDIVIDUAL)
  reviewStatus         PricingReviewStatus          @default(AUTO_APPROVED)
  requesterDecision    RequestPricingDecisionStatus @default(PENDING)
  justification        String?                      @db.Text
  requesterNote        String?                      @db.Text
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  requesterRespondedAt DateTime?

  @@index([requestId, createdAt])
  @@index([proposedById, createdAt])
  @@index([reviewStatus, createdAt])
  @@index([requesterDecision, createdAt])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([trackId, userId])
  @@index([userId, createdAt])
  @@index([trackId])
}

model Order {
  id                    Int            @id @default(autoincrement())
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  status                OrderStatus    @default(PENDING)
  currency              String         @default("gbp")
  amountTotal           Int
  stripeCheckoutSession String?        @unique
  stripePaymentIntent   String?        @unique
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  items                 OrderItem[]
  paymentEvents         PaymentEvent[]

  @@index([userId])
  @@index([userId, status, createdAt])
}

model OrderItem {
  id                 Int               @id @default(autoincrement())
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId            Int
  track              Track             @relation(fields: [trackId], references: [id], onDelete: Restrict)
  trackId            Int
  sourceRelease      CatalogueRelease? @relation(fields: [sourceReleaseId], references: [id], onDelete: SetNull)
  sourceReleaseId    Int?
  sourceReleaseTitle String?
  title              String
  composer           String
  unitAmount         Int
  currency           String            @default("gbp")

  @@unique([orderId, trackId])
  @@index([trackId])
  @@index([sourceReleaseId])
}

model PaymentEvent {
  id            Int      @id @default(autoincrement())
  stripeEventId String   @unique
  type          String
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId       Int?
  payload       String   @db.Text
  processedAt   DateTime @default(now())

  @@index([orderId])
}

model AuditEvent {
  id         Int      @id @default(autoincrement())
  action     String
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  entityType String
  entityId   String
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model UserAccessChangeRequest {
  id                      Int                           @id @default(autoincrement())
  targetUser              User                          @relation("UserAccessChangeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetUserId            String
  requestedBy             User                          @relation("UserAccessChangeRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  requestedById           String
  reviewedBy              User?                         @relation("UserAccessChangeReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById            String?
  status                  UserAccessChangeRequestStatus @default(PENDING)
  requestedRole           UserRole?
  requestedAccountStatus  UserAccountStatus?
  requestedUploaderStatus UploaderStatus?
  reason                  String?                       @db.Text
  reviewNote              String?                       @db.Text
  createdAt               DateTime                      @default(now())
  reviewedAt              DateTime?
  appliedAt               DateTime?

  @@index([status, createdAt])
  @@index([targetUserId])
  @@index([requestedById])
  @@index([reviewedById])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum TrackStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum TrackRequestStatus {
  OPEN
  PENDING_DECISION
  ACCEPTED
  REJECTED
  COMPLETED
}

enum TrackRequestResponseStatus {
  ACCEPTED
  DECLINED
  COMPLETED
  WITHDRAWN
}

enum CatalogueType {
  SINGLE_TRACK
  MOVEMENT
  SONG_CYCLE
  COLLECTION
  LEARNING_PACK
  OPERA_EXCERPT
  COMPLETE_WORK
}

enum SaleFormat {
  INDIVIDUAL
  BUNDLE
  BOTH
}

enum CatalogueReleaseStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  NEEDS_CHANGES
  REJECTED
  ARCHIVED
}

enum PricingReviewStatus {
  AUTO_APPROVED
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

enum RequestPricingDecisionStatus {
  PENDING
  ACCEPTED
  DECLINED
  SUPERSEDED
}

enum UserRole {
  CUSTOMER
  UPLOADER
  ADMIN
  SUPPORT
}

enum UserAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UploaderStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  REJECTED
}

enum TrackModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TrackProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum UploadBatchStatus {
  DRAFT
  UPLOADING
  READY_FOR_REVIEW
  SUBMITTED
  PARTIALLY_FAILED
  COMPLETED
  ARCHIVED
}

enum UserAccessChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
