# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AWS S3 - server-side only
S3_ACCESS_ID=""
S3_APP_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_REGION="eu-west-2"

# Stripe - server-side unless explicitly NEXT_PUBLIC
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Local demo escape hatch only. Production should leave this unset/false.
ALLOW_SIMULATED_PURCHASES="false"
