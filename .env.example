# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
EMAIL_SERVER=""
EMAIL_FROM=""
ADMIN_ACCESS_REVIEW_EMAIL_RECIPIENTS=""

# Optional deployment branch guardrails.
CMC_EXPECTED_PRODUCTION_BRANCH="master"
CMC_EXPECTED_PREVIEW_BRANCH="dev"

# Optional dev/preview-only synthetic audio fixtures for seeded demo tracks.
CMC_ENABLE_SYNTHETIC_FIXTURES="false"

# AWS S3 - server-side only
S3_ACCESS_ID=""
S3_APP_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_REGION="eu-west-2"
S3_KEY_PREFIX=""

# Stripe - server-side unless explicitly NEXT_PUBLIC
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Local demo escape hatch only. Production should leave this unset/false.
ALLOW_SIMULATED_PURCHASES="false"

# Optional demo seeding. Use only against non-production databases/buckets.
DEMO_SEED_USER_EMAIL="demo-uploader@example.com"
DEMO_SEED_USER_NAME="Demo Uploader"

# Optional security alert window for `yarn security:alerts`.
SECURITY_ALERT_WINDOW_MINUTES="15"

# Optional admin review metrics windows for `yarn security:access-reviews`.
ADMIN_ACCESS_REVIEW_METRICS_WINDOW_DAYS="30"
ADMIN_ACCESS_REVIEW_OVERDUE_HOURS="24"

# Optional sensitive mutation session max age. Leave unset to disable.
CMC_SENSITIVE_SESSION_MAX_AGE_MINUTES=""

# Optional development-only audit cleanup rehearsal.
AUDIT_CLEANUP_RETENTION_DAYS="365"
AUDIT_CLEANUP_EXECUTE="false"
AUDIT_CLEANUP_CONFIRM=""
